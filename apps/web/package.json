{
  "name": "@developer-brand-copilot/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @developer-brand-copilot/config build && pnpm --filter @developer-brand-copilot/contracts build",
    "dev": "next dev --port 3000",
    "predev:e2e": "pnpm --filter @developer-brand-copilot/config build && pnpm --filter @developer-brand-copilot/contracts build",
    "dev:e2e": "next dev --port 3100",
    "prebuild": "pnpm --filter @developer-brand-copilot/config build && pnpm --filter @developer-brand-copilot/contracts build",
    "build": "next build",
    "start": "next start --port 3000",
    "pretypecheck": "pnpm --filter @developer-brand-copilot/config build && pnpm --filter @developer-brand-copilot/contracts build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @developer-brand-copilot/config build && pnpm --filter @developer-brand-copilot/contracts build",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@developer-brand-copilot/config": "workspace:*",
    "@developer-brand-copilot/contracts": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
