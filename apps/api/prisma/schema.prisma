generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  createdAt                DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                  @default(now()) @updatedAt @db.Timestamptz(3)
  projects                 Project[]
  gitHubConnections        GitHubConnection[]
  gitHubConnectionAttempts GitHubConnectionAttempt[]
}

model Project {
  id                       String                    @id @default(uuid()) @db.Uuid
  userId                   String                    @db.Uuid
  timezone                 String
  createdAt                DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                  @default(now()) @updatedAt @db.Timestamptz(3)
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connectedRepository      ConnectedRepository?
  gitHubConnectionAttempts GitHubConnectionAttempt[]
  developmentEvents        DevelopmentEvent[]
  aiExecutions             AIExecution[]
  projectState             ProjectState?
  intelligenceRuns         IntelligenceRun[]

  @@index([userId])
}

enum GitHubConnectionStatus {
  active
  disconnected
  authorization_error
}

enum SyncRunStatus {
  queued
  running
  succeeded
  failed_retryable
  failed_terminal
  cancelled
}

model GitHubConnection {
  id                     String                 @id @default(uuid()) @db.Uuid
  userId                 String                 @db.Uuid
  providerInstallationId BigInt                 @db.BigInt
  providerAccountId      BigInt                 @db.BigInt
  accountLogin           String
  accountType            String
  status                 GitHubConnectionStatus @default(active)
  createdAt              DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime               @default(now()) @updatedAt @db.Timestamptz(3)
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  repositories           ConnectedRepository[]

  @@unique([userId, providerInstallationId])
  @@index([userId])
}

model ConnectedRepository {
  id                   String                 @id @default(uuid()) @db.Uuid
  projectId            String                 @unique @db.Uuid
  gitHubConnectionId   String                 @db.Uuid
  providerRepositoryId BigInt                 @db.BigInt
  owner                String
  name                 String
  defaultBranch        String
  isPrivate            Boolean
  status               GitHubConnectionStatus @default(active)
  lastSuccessfulSyncAt DateTime?              @db.Timestamptz(3)
  createdAt            DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime               @default(now()) @updatedAt @db.Timestamptz(3)
  project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gitHubConnection     GitHubConnection       @relation(fields: [gitHubConnectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  commits              GitHubCommit[]
  pullRequests         GitHubPullRequest[]
  syncRuns             SyncRun[]

  @@unique([gitHubConnectionId, providerRepositoryId])
  @@index([gitHubConnectionId])
}

model GitHubCommit {
  id                    String              @id @default(uuid()) @db.Uuid
  connectedRepositoryId String              @db.Uuid
  sha                   String              @db.VarChar(64)
  message               String
  authorName            String?             @db.VarChar(255)
  authorLogin           String?             @db.VarChar(255)
  authoredAt            DateTime            @db.Timestamptz(3)
  committedAt           DateTime            @db.Timestamptz(3)
  parentShas            String[]            @default([])
  additions             Int?
  deletions             Int?
  changedFiles          Int?
  orphanedAt            DateTime?           @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  connectedRepository   ConnectedRepository @relation(fields: [connectedRepositoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  files                 GitHubCommitFile[]
  developmentEventEvidence DevelopmentEventCommitEvidence[]

  @@unique([connectedRepositoryId, sha])
  @@index([connectedRepositoryId, committedAt])
}

model GitHubCommitFile {
  id             String       @id @default(uuid()) @db.Uuid
  gitHubCommitId String       @db.Uuid
  path           String
  previousPath   String?
  status         String       @db.VarChar(32)
  additions      Int
  deletions      Int
  changes        Int
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  gitHubCommit   GitHubCommit @relation(fields: [gitHubCommitId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([gitHubCommitId, path])
  @@index([gitHubCommitId])
}

model GitHubPullRequest {
  id                    String                    @id @default(uuid()) @db.Uuid
  connectedRepositoryId String                    @db.Uuid
  providerPullRequestId BigInt                    @db.BigInt
  number                Int
  title                 String
  bodySummary           String?                   @db.VarChar(2000)
  state                 String                    @db.VarChar(16)
  authorLogin           String?                   @db.VarChar(255)
  baseBranch            String                    @db.VarChar(255)
  headBranch            String                    @db.VarChar(255)
  providerCreatedAt     DateTime                  @db.Timestamptz(3)
  providerUpdatedAt     DateTime                  @db.Timestamptz(3)
  mergedAt              DateTime                  @db.Timestamptz(3)
  mergeCommitSha        String?                   @db.VarChar(64)
  additions             Int
  deletions             Int
  changedFiles          Int
  createdAt             DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                  @default(now()) @updatedAt @db.Timestamptz(3)
  connectedRepository   ConnectedRepository       @relation(fields: [connectedRepositoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  files                 GitHubPullRequestFile[]
  linkedCommits         GitHubPullRequestCommit[]
  developmentEventEvidence DevelopmentEventPullRequestEvidence[]

  @@unique([connectedRepositoryId, providerPullRequestId])
  @@unique([connectedRepositoryId, number])
  @@index([connectedRepositoryId, mergedAt])
}

model GitHubPullRequestFile {
  id                  String            @id @default(uuid()) @db.Uuid
  gitHubPullRequestId String            @db.Uuid
  path                String
  previousPath        String?
  status              String            @db.VarChar(32)
  additions           Int
  deletions           Int
  changes             Int
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  gitHubPullRequest   GitHubPullRequest @relation(fields: [gitHubPullRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([gitHubPullRequestId, path])
  @@index([gitHubPullRequestId])
}

model GitHubPullRequestCommit {
  id                  String            @id @default(uuid()) @db.Uuid
  gitHubPullRequestId String            @db.Uuid
  sha                 String            @db.VarChar(64)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  gitHubPullRequest   GitHubPullRequest @relation(fields: [gitHubPullRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([gitHubPullRequestId, sha])
  @@index([gitHubPullRequestId])
}

model SyncRun {
  id                     String              @id @default(uuid()) @db.Uuid
  connectedRepositoryId  String              @db.Uuid
  status                 SyncRunStatus       @default(queued)
  idempotencyKey         String              @db.VarChar(64)
  cursorVersion          Int                 @default(1)
  windowStart            DateTime            @db.Timestamptz(3)
  windowEnd              DateTime            @db.Timestamptz(3)
  startedAt              DateTime?           @db.Timestamptz(3)
  finishedAt             DateTime?           @db.Timestamptz(3)
  commitsDiscovered      Int                 @default(0)
  commitsInserted        Int                 @default(0)
  pullRequestsDiscovered Int                 @default(0)
  pullRequestsInserted   Int                 @default(0)
  attemptCount           Int                 @default(0)
  workerAttemptCount     Int                 @default(0)
  retryAfterAt           DateTime?           @db.Timestamptz(3)
  leaseToken             String?             @db.Uuid
  leaseExpiresAt         DateTime?           @db.Timestamptz(3)
  failureCode            String?             @db.VarChar(64)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  connectedRepository    ConnectedRepository @relation(fields: [connectedRepositoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  intelligenceRuns       IntelligenceRun[]

  @@unique([connectedRepositoryId, idempotencyKey])
  @@index([connectedRepositoryId, createdAt])
  @@index([connectedRepositoryId, status])
}

enum IntelligenceRunStatus {
  queued
  running
  succeeded
  failed_retryable
  failed_terminal
}

enum IntelligenceRunTrigger {
  sync_completion
  manual_reprocess
}

model IntelligenceRun {
  id                    String                 @id @default(uuid()) @db.Uuid
  projectId             String                 @db.Uuid
  sourceSyncRunId       String                 @db.Uuid
  status                IntelligenceRunStatus  @default(queued)
  trigger               IntelligenceRunTrigger
  runKey                String                 @db.VarChar(64)
  processingVersion     String                 @db.VarChar(64)
  groupingVersion       String                 @db.VarChar(64)
  interpretationVersion String                 @db.VarChar(64)
  projectionVersion     String                 @db.VarChar(64)
  sourceWindowStart     DateTime               @db.Timestamptz(3)
  sourceWindowEnd       DateTime               @db.Timestamptz(3)
  queuedAt              DateTime               @default(now()) @db.Timestamptz(3)
  startedAt             DateTime?              @db.Timestamptz(3)
  finishedAt            DateTime?              @db.Timestamptz(3)
  attemptCount          Int                    @default(0)
  retryAfterAt          DateTime?              @db.Timestamptz(3)
  leaseToken            String?                @db.Uuid
  leaseExpiresAt        DateTime?              @db.Timestamptz(3)
  groupsDiscovered      Int                    @default(0)
  groupsSucceeded       Int                    @default(0)
  groupsRejected        Int                    @default(0)
  groupsFailed          Int                    @default(0)
  failureCode           String?                @db.VarChar(64)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @default(now()) @updatedAt @db.Timestamptz(3)
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceSyncRun         SyncRun                @relation(fields: [sourceSyncRunId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectId, runKey])
  @@unique([sourceSyncRunId, processingVersion])
  @@index([projectId, createdAt])
  @@index([status, retryAfterAt, leaseExpiresAt, queuedAt])
}

model GitHubConnectionAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  projectId   String   @db.Uuid
  stateDigest String   @unique @db.VarChar(64)
  expiresAt   DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([expiresAt])
}

enum DevelopmentEventType {
  feature_started
  feature_completed
  bug_fixed
  ui_improved
  architecture_decision
  testing_milestone
  performance_improvement
  release
  project_milestone
  refactor_completed
}

enum DevelopmentEventStatus {
  active
  superseded
  rejected
}

enum AIExecutionStage {
  development_event_interpretation
}

enum AIExecutionStatus {
  running
  succeeded
  rejected
  failed
}

enum AIValidationStatus {
  pending
  valid
  invalid
}

model DevelopmentEvent {
  id                       String                                @id @default(uuid()) @db.Uuid
  projectId                String                                @db.Uuid
  eventKey                 String                                @db.VarChar(64)
  inputFingerprint         String                                @db.VarChar(64)
  extractionVersion        String                                @db.VarChar(64)
  type                     DevelopmentEventType
  title                    String
  summary                  String
  importanceScore          Decimal                               @db.Decimal(4, 3)
  contentPotentialScore    Decimal                               @db.Decimal(4, 3)
  confidence               Decimal                               @db.Decimal(4, 3)
  occurredAt               DateTime                              @db.Timestamptz(3)
  technologies             String[]                              @default([])
  relatedFeatureIds        String[]                              @default([])
  status                   DevelopmentEventStatus                @default(active)
  supersedesEventId        String?                               @unique @db.Uuid
  createdAt                DateTime                              @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                              @default(now()) @updatedAt @db.Timestamptz(3)
  project                  Project                               @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  supersedesEvent          DevelopmentEvent?                     @relation("DevelopmentEventSupersession", fields: [supersedesEventId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supersededBy             DevelopmentEvent?                     @relation("DevelopmentEventSupersession")
  commitEvidence           DevelopmentEventCommitEvidence[]
  pullRequestEvidence      DevelopmentEventPullRequestEvidence[]
  projectStateVersionLinks ProjectStateVersionEvent[]
  aiExecutions             AIExecution[]

  @@unique([projectId, eventKey, extractionVersion])
  @@index([projectId, occurredAt])
  @@index([projectId, status])
  @@index([projectId, inputFingerprint])
}

model AIExecution {
  id                            String             @id @default(uuid()) @db.Uuid
  projectId                     String             @db.Uuid
  developmentEventId            String?            @db.Uuid
  stage                         AIExecutionStage
  status                        AIExecutionStatus  @default(running)
  inputFingerprint              String             @db.VarChar(64)
  model                         String             @db.VarChar(100)
  modelConfiguration            Json
  modelConfigurationFingerprint String             @db.VarChar(64)
  promptVersion                 String             @db.VarChar(64)
  schemaVersion                 String             @db.VarChar(64)
  attemptNumber                 Int
  validationStatus              AIValidationStatus @default(pending)
  failureCode                   String?            @db.VarChar(64)
  startedAt                     DateTime           @db.Timestamptz(3)
  completedAt                   DateTime?          @db.Timestamptz(3)
  latencyMs                     Int?
  inputTokens                   Int?
  outputTokens                  Int?
  createdAt                     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  project                       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  developmentEvent              DevelopmentEvent?  @relation(fields: [developmentEventId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([projectId, stage, inputFingerprint, promptVersion, modelConfigurationFingerprint, attemptNumber])
  @@index([projectId, stage, createdAt])
  @@index([developmentEventId])
}

model DevelopmentEventCommitEvidence {
  id                 String            @id @default(uuid()) @db.Uuid
  developmentEventId String            @db.Uuid
  gitHubCommitId     String?           @db.Uuid
  commitSha          String            @db.VarChar(64)
  detachedAt         DateTime?         @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  developmentEvent   DevelopmentEvent  @relation(fields: [developmentEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gitHubCommit       GitHubCommit?     @relation(fields: [gitHubCommitId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([developmentEventId, commitSha])
  @@unique([developmentEventId, gitHubCommitId])
  @@index([gitHubCommitId])
}

model DevelopmentEventPullRequestEvidence {
  id                        String             @id @default(uuid()) @db.Uuid
  developmentEventId        String             @db.Uuid
  gitHubPullRequestId       String?            @db.Uuid
  providerPullRequestId     BigInt             @db.BigInt
  detachedAt                DateTime?          @db.Timestamptz(3)
  createdAt                 DateTime           @default(now()) @db.Timestamptz(3)
  developmentEvent          DevelopmentEvent   @relation(fields: [developmentEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gitHubPullRequest         GitHubPullRequest? @relation(fields: [gitHubPullRequestId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([developmentEventId, providerPullRequestId])
  @@unique([developmentEventId, gitHubPullRequestId])
  @@index([gitHubPullRequestId])
}

model ProjectState {
  id                 String                @id @default(uuid()) @db.Uuid
  projectId          String                @unique @db.Uuid
  purpose            String?
  targetAudience     String?
  technologies       String[]              @default([])
  currentPhase       String?
  activeFeatures     Json                  @default("[]")
  completedFeatures  Json                  @default("[]")
  recentMilestones   Json                  @default("[]")
  sourceFingerprint  String                @db.VarChar(64)
  projectionVersion  String                @db.VarChar(64)
  version            Int
  lastUpdatedAt      DateTime              @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @default(now()) @updatedAt @db.Timestamptz(3)
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  versions           ProjectStateVersion[]

  @@unique([projectId, sourceFingerprint, projectionVersion])
}

model ProjectStateVersion {
  id                 String                     @id @default(uuid()) @db.Uuid
  projectStateId     String                     @db.Uuid
  version            Int
  purpose            String?
  targetAudience     String?
  technologies       String[]                   @default([])
  currentPhase       String?
  activeFeatures     Json                       @default("[]")
  completedFeatures  Json                       @default("[]")
  recentMilestones   Json                       @default("[]")
  sourceFingerprint  String                     @db.VarChar(64)
  projectionVersion  String                     @db.VarChar(64)
  lastUpdatedAt      DateTime                   @db.Timestamptz(3)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  projectState       ProjectState               @relation(fields: [projectStateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  developmentEvents  ProjectStateVersionEvent[]

  @@unique([projectStateId, version])
  @@unique([projectStateId, sourceFingerprint, projectionVersion])
  @@index([projectStateId, createdAt])
}

model ProjectStateVersionEvent {
  id                    String              @id @default(uuid()) @db.Uuid
  projectStateVersionId String              @db.Uuid
  developmentEventId    String              @db.Uuid
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  projectStateVersion   ProjectStateVersion @relation(fields: [projectStateVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  developmentEvent      DevelopmentEvent    @relation(fields: [developmentEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectStateVersionId, developmentEventId])
  @@index([developmentEventId])
}
