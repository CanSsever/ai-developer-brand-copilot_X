{
  "name": "developer-brand-copilot",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.22.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present --fail-if-no-match test",
    "security:secrets": "node scripts/run-gitleaks.mjs",
    "db:generate": "pnpm --filter @developer-brand-copilot/api db:generate",
    "db:validate": "pnpm --filter @developer-brand-copilot/api db:validate",
    "db:format": "pnpm --filter @developer-brand-copilot/api db:format",
    "db:migrate:dev": "pnpm --filter @developer-brand-copilot/api db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @developer-brand-copilot/api db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @developer-brand-copilot/api db:migrate:status",
    "db:check": "pnpm --filter @developer-brand-copilot/api db:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
